# Maintainer: Samuel Ruairí Bullard <samuel.ruairi.bullard@gmail.com>
#
# Quoth: offline, private, instant voice dictation for Linux (Wayland).
# Builds the native libs, installs the wheel + data + icons + desktop entry, and
# prints a welcome on a first install (quoth.install). The icon/desktop cache
# refresh is automatic on Arch via alpm hooks; the recipe does nothing for it.
#
# Builds Vulkan + the Intel-NPU OpenVINO encoder: the trimmed OpenVINO
# runtime is vendored from a pinned wheel into the package, so libwhisper.so's
# NEEDED libopenvino.so is always present. The iGPU is reached via Vulkan, the NPU
# via OpenVINO; no OpenVINO GPU plugin is shipped.

pkgname=quoth
pkgver=0.1.0
pkgrel=1
pkgdesc="Offline, private, instant voice dictation for Linux (Wayland; GPU via Vulkan, Intel NPU via OpenVINO)"
arch=('x86_64')   # compiles a native Vulkan + OpenVINO libwhisper.so
url="https://quoth.dev"
# The GPL app plus its bundled components and assets, as one SPDX expression.
license=('GPL-3.0-or-later AND MIT AND Apache-2.0 AND ISC AND BSD-3-Clause AND FTL AND MPL-2.0')
# No -debug package: Arch's debuginfod covers official packages only. strip still
# runs on every ELF file.
options=(!debug)
_srcname="quoth-$pkgver"
# Pinned native sources: kept in sync with packaging/pins.sh by scripts/sync_pins.sh.
_sentryver="2.72.0"
_whispertag="v1.9.5"   # floor is 1.8.1: 1.8.0 broke iGPU Vulkan
_whispersha="ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720"
# OpenVINO runtime for the NPU encoder. We extract files (not pip-install), so
# the wheel's Python tag is irrelevant: any cp3x manylinux x86_64 wheel works.
_ovwheel="openvino-2026.4.1-22982-cp310-cp310-manylinux_2_28_x86_64.whl"
_ovurl="https://files.pythonhosted.org/packages/c4/57/b2d53cfb56be03449a95df18a76fe443ae94b16b3ae15128ca65e08dcd91/openvino-2026.4.1-22982-cp310-cp310-manylinux_2_28_x86_64.whl"
_ovsha="47dcccbab40a23aed1dc4af7c43a9c813cc61f684d66498e1627d407d5f2770b"
# ThorVG: the Lottie renderer. Arch has no official package (AUR only), so
# it is built from source here like every other channel.
_thorvgtag="v1.1.3"
_thorvgsha="ba9957aeeadb4151d4486f11c638ae118c00210fa4906daa7b30143aa341e690"

depends=(
  glib2 gtk4 libadwaita pango python-gobject dconf hicolor-icon-theme
  gstreamer gst-plugins-base-libs gst-plugins-good gst-plugin-pipewire
  gtk4-layer-shell wl-clipboard wtype ydotool
  glibc libgcc libstdc++ libgomp vulkan-icd-loader
  python python-numpy python-evdev python-loguru python-cairo "python-sentry_sdk>=${_sentryver}"
  intel-npu-driver intel-npu-compiler
)
optdepends=(
  'vulkan-radeon: GPU acceleration on AMD graphics'
  'vulkan-intel: GPU acceleration on Intel graphics'
  'nvidia-utils: GPU acceleration on NVIDIA graphics'
  'gnome-shell-extension-appindicator: tray icon on GNOME'
)
makedepends=(
  cmake meson ninja shaderc spirv-headers vulkan-headers git
  python-build python-installer python-wheel python-hatchling
)
install="$pkgname.install"
source=(
  "https://github.com/abullard1/Quoth/releases/download/v$pkgver/$_srcname.tar.gz"
  "whisper.cpp-$_whispertag.tar.gz::https://github.com/ggml-org/whisper.cpp/archive/refs/tags/$_whispertag.tar.gz"
  "$_ovurl"
  "thorvg-$_thorvgtag.tar.gz::https://github.com/thorvg/thorvg/archive/refs/tags/$_thorvgtag.tar.gz"
)
# The quoth source is the release's git-archive asset. Its hash is filled in only
# in the published AUR recipe, which is generated from the released bytes.
sha256sums=(
  'SKIP'
  "$_whispersha"
  "$_ovsha"
  "$_thorvgsha"
)

prepare() {
  # build_whisper.sh / the Makefile expect the whisper.cpp source at a stable path.
  rm -rf "$srcdir/whisper.cpp"
  mv "$srcdir/whisper.cpp-${_whispertag#v}" "$srcdir/whisper.cpp"
  "$srcdir/$_srcname/scripts/apply_whisper_patches.sh" \
    --apply "$srcdir/whisper.cpp"
  # vendor_thorvg.sh expects the source at a stable path, like whisper.cpp.
  rm -rf "$srcdir/thorvg"
  mv "$srcdir/thorvg-${_thorvgtag#v}" "$srcdir/thorvg"
  # Extract the OpenVINO wheel once: its cmake/headers drive the WITH_OPENVINO
  # build; vendor_openvino.sh trims its libs/ into the bundled runtime.
  rm -rf "$srcdir/openvino-wheel"
  python -m zipfile -e "$srcdir/$_ovwheel" "$srcdir/openvino-wheel"
}

build() {
  cd "$srcdir/$_srcname"
  # Vulkan + OpenVINO-NPU libwhisper.so (+ggml) + C shim, staged in lib/.
  make build WHISPER_DIR="$srcdir/whisper.cpp" \
    WITH_OPENVINO=ON OpenVINO_DIR="$srcdir/openvino-wheel/openvino/cmake"
  make vendor-openvino OPENVINO_WHEEL_DIR="$srcdir/openvino-wheel"
  make vendor-thorvg THORVG_SRC="$srcdir/thorvg"
  # The Python wheel (channel-specific, not in the Makefile).
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$_srcname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  # Desktop/icons/metainfo + bundle the native + OpenVINO libs.
  make install-data DESTDIR="$pkgdir" PREFIX=/usr \
    QUOTH_RELEASE="${QUOTH_RELEASE:-quoth@$pkgver}" \
    QUOTH_ENVIRONMENT="${QUOTH_ENVIRONMENT:-production}" \
    QUOTH_CHANNEL=aur
  # Bundled third-party license texts in the conventional location. MIT and
  # Apache-2.0 each carry their own copyright, so ship them explicitly (the
  # native libwhisper + OpenVINO staged during build()).
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 lib/LICENSE.whisper-cpp \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.whisper-cpp"
  install -Dm644 lib/openvino/licenses/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.openvino"
  install -Dm644 lib/LICENSE.thorvg \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.thorvg"
}
