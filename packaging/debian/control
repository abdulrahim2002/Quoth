Architecture: amd64
# The UI uses libadwaita 1.5 APIs (Adw.AlertDialog / Adw.AboutDialog) and the CLI
# GLib 2.80 ones (--version, error output), so both typelib floors are gated: apt
# refuses cleanly on too-old distros (Ubuntu 22.04, Debian 12) instead of installing
# and crashing at startup. Those get the Flatpak.
Depends:
 ${python3:Depends},
 ${shlibs:Depends},
