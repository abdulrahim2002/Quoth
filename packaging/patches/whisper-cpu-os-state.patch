diff --git a/ggml/src/ggml-cpu/arch/x86/cpu-feats.cpp b/ggml/src/ggml-cpu/arch/x86/cpu-feats.cpp
--- a/ggml/src/ggml-cpu/arch/x86/cpu-feats.cpp
+++ b/ggml/src/ggml-cpu/arch/x86/cpu-feats.cpp
@@ -6,6 +6,7 @@
 #include <intrin.h>
 #endif
 
+#include <cstdint>
 #include <cstring>
 #include <vector>
 #include <bitset>
@@ -88,6 +89,35 @@ struct cpuid_x86 {
     bool AMX_BF16(void) { return f_7_edx[22]; }
 
 #ifdef _MSC_VER
+    static uint64_t xgetbv(unsigned int xcr) {
+        return _xgetbv(xcr);
+    }
+#else
+    static uint64_t xgetbv(unsigned int xcr) {
+        unsigned int eax;
+        unsigned int edx;
+        __asm__ __volatile__("xgetbv" : "=a"(eax), "=d"(edx) : "c"(xcr));
+        return (static_cast<uint64_t>(edx) << 32) | eax;
+    }
+#endif
+
+    bool os_saves(uint64_t mask) {
+        return XSAVE() && OSXSAVE() && (xgetbv(0) & mask) == mask;
+    }
+
+    bool os_saves_ymm(void) {
+        return os_saves(0x6);
+    }
+
+    bool os_saves_zmm(void) {
+        return os_saves(0xe6);
+    }
+
+    bool os_saves_amx(void) {
+        return os_saves(0x600e6);
+    }
+
+#ifdef _MSC_VER
     static void cpuid(int cpu_info[4], int eax) {
         __cpuid(cpu_info, eax);
     }
@@ -261,17 +291,15 @@ void test_x86_is() {
